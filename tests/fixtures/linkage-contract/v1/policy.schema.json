{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "approved": {
      "type": "boolean"
    },
    "synthetic_only": {
      "type": "boolean"
    },
    "current_stage": {
      "const": 1
    },
    "enabled_items": {
      "type": "array",
      "items": {
        "enum": [
          "C1",
          "C3"
        ]
      },
      "uniqueItems": true
    },
    "c1_identity_rule": {
      "const": "exact_verified_entity_set"
    },
    "c3_threshold": {
      "type": [
        "string",
        "null"
      ]
    },
    "c3_account_mapping_approved": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "version",
    "approved",
    "synthetic_only",
    "current_stage",
    "enabled_items",
    "c1_identity_rule",
    "c3_threshold",
    "c3_account_mapping_approved"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
