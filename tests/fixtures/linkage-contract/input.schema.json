  "required": [
    "schema_version",
    "synthetic",
    "identity",
    "item",
    "sources",
    "sustainability",
    "financial",
    "comparability",
    "explanation",
    "c3_context",
    "claim",
    "search",
    "c4_context"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "item": {
            "const": "C3"
          }
        }
      },
      "then": {
        "properties": {
          "c3_context": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "item": {
            "const": "C4"
          }
        }
      },
      "then": {
        "properties": {
          "c4_context": {
            "type": "object"
          }
        }
      }
    }
  ]
}
