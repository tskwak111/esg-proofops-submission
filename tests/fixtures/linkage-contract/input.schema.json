{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "synthetic": {
      "type": "boolean"
    },
    "identity": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "company_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "package_id": {
          "type": "string",
          "minLength": 1
        },
        "period_start": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "period_end": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "sustainability_document_version": {
          "type": "string",
          "minLength": 1
        },
        "financial_document_version": {
          "type": "string",
          "minLength": 1
        },
        "dart_corp_code": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "financial_fiscal_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200
        },
        "consolidation": {
          "enum": [
            "consolidated",
            "separate",
            "unknown"
          ]
        },
        "financial_period_start": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
