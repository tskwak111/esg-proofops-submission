        "coverage_policy_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "required_document_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reviewed_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "failed_document_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "receipt_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "state",
        "coverage_policy_id",
        "required_document_ids",
        "reviewed_source_ids",
        "failed_document_ids",
        "receipt_id"
      ],
      "additionalProperties": false
    },
    "c4_context": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "classification_name": {
              "type": "string",
              "minLength": 1
            },
            "definition_source_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "calculation_source_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "classification_name",
            "definition_source_ids",
            "calculation_source_ids"
          ],
          "additionalProperties": false
        }
      ]
