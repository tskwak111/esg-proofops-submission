        "financial_period_end": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "sr_published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "financial_published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "rcept_no": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "tenant_id",
        "company_id",
        "claim_id",
        "package_id",
        "period_start",
        "period_end",
        "sustainability_document_version",
        "financial_document_version",
        "dart_corp_code",
        "financial_fiscal_year",
        "consolidation",
        "financial_period_start",
        "financial_period_end",
        "sr_published_at",
        "financial_published_at",
        "rcept_no",
        "as_of_date"
      ],
      "additionalProperties": false
    },
    "item": {
      "enum": [
        "C1",
        "C2",
        "C3",
        "C4"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "document_id",
          "artifact_sha256",
          "locator",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "sustainability": {
      "type": "object",
      "properties": {
        "raw": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "normalized": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "kind": {
          "enum": [
            "entity_set",
            "facility_set",
            "currency_amount",
            "period",
            "classification",
            "unknown"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "raw",
        "normalized",
        "kind",
        "unit",
        "source_id"
      ],
      "additionalProperties": false
    },
    "financial": {
      "type": "object",
      "properties": {
        "raw": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "normalized": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "kind": {
          "enum": [
            "entity_set",
            "facility_set",
            "currency_amount",
            "period",
            "classification",
            "unknown"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "raw",
        "normalized",
        "kind",
        "unit",
        "source_id"
      ],
      "additionalProperties": false
    },
    "comparability": {
      "enum": [
        "comparable",
        "not_comparable",
        "unknown"
      ]
    },
    "explanation": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "search_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "search_complete"
      ],
      "additionalProperties": false
    },
    "c3_context": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "minLength": 1
            },
            "target_period_start": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target_period_end": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "capex_period_start": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "capex_period_end": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "capex_account_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "commitment_source_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "funding_plan_source_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
