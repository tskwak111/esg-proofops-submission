        "trigger_elements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "fiscal_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200
        }
      },
      "required": [
        "track",
        "quote",
        "source_id",
        "trigger_elements",
        "fiscal_year"
      ],
      "additionalProperties": false
