# local/staging/production; production은 fake adapters 거부 | required=yes | env=all
APP_ENV=local

# 허용 단일 웹 origin | required=yes | env=all
APP_ORIGIN=http://localhost:5173

# BFF callback/API base | required=yes | env=all
API_PUBLIC_BASE_URL=http://localhost:8000

# 저장/API 기본 리전, 실제 account 확인 | required=cloud | env=staging/production
AWS_REGION=ap-northeast-2

# 승인된 모델 처리 리전 CSV; 비어 있으면 외부 전송 차단 | required=live | env=all
MODEL_ALLOWED_PROCESSING_REGIONS=

# 개발자 credentials profile; production IAM role | required=no | env=local
AWS_PROFILE=

# private 원본/파생물 bucket | required=cloud | env=staging/production
S3_ARTIFACT_BUCKET=

# 검증 전 업로드 bucket | required=cloud | env=staging/production
S3_QUARANTINE_BUCKET=

# 운영 core table | required=cloud | env=staging/production
DDB_CORE_TABLE=

# append-only audit table | required=cloud | env=staging/production
DDB_AUDIT_TABLE=

# stage queue URL | required=cloud | env=staging/production
SQS_JOB_QUEUE_URL=

# dead-letter queue | required=cloud | env=staging/production
SQS_DLQ_URL=

# 암호화 key ARN | required=cloud | env=staging/production
KMS_KEY_ARN=

# 승인된 Serverless collection endpoint | required=cloud | env=staging/production
OPENSEARCH_ENDPOINT=

# 임베딩1024d index generation | required=yes | env=all
OPENSEARCH_INDEX_GENERATION=proofops-chunks-v1

# 실재 user pool | required=cloud | env=staging/production
COGNITO_USER_POOL_ID=

# PKCE client ID | required=cloud | env=staging/production
COGNITO_CLIENT_ID=

# Hosted UI issuer domain | required=cloud | env=staging/production
COGNITO_DOMAIN=

# 세션/CSRF 서명 secret의 SecretsManager 참조 | required=cloud | env=staging/production
SESSION_SECRET_ARN=

# pagination HMAC key 참조 | required=cloud | env=staging/production
CURSOR_SECRET_ARN=

# 배포 runtime ARN | required=cloud | env=staging/production
AGENTCORE_RUNTIME_ARN=

# 실계정 model capability snapshot 파일 | required=live | env=all
MODEL_BINDINGS_PATH=config/model_bindings.json

# 문서권리·처리리전 승인 profile | required=live | env=all
CONSENT_PROFILE_PATH=config/consent_profile.json

# 도메인 rule pack manifest | required=yes | env=all
RULE_PACK_PATH=config/rule_pack_manifest.yaml

# 파서/geometry routing 설정 | required=yes | env=all
PARSER_PROFILE_PATH=config/parsing.yaml

# 토큰·파일·작업 예산 | required=yes | env=all
LIMITS_PATH=config/limits.yaml

# 로컬만 파일 artifact | required=local | env=local
LOCAL_ARTIFACT_DIR=.local/artifacts

# local integration용 상태 | required=local | env=local
LOCAL_DATABASE_PATH=.local/state.sqlite3

# synthetic/bedrock; production은bedrock만 | required=yes | env=all
MODEL_ADAPTER=synthetic

# 승인 benchmark 후true | required=yes | env=all
ENABLE_HYBRID_PARSER=false

# 승인된 local/VPC backend만 | required=hybrid | env=all
HYBRID_BACKEND_URL=

# license gate 승인 시에만true | required=yes | env=all
ENABLE_LEGACY_PYMUPDF=false

# P0 off; source truth가 아님 | required=yes | env=all
ENABLE_AGENTCORE_MEMORY=false

# 전용 승인 rules 필요 | required=yes | env=all
ENABLE_ADVERTISING_MODE=false

# P1 feature flag | required=yes | env=all
ENABLE_YEAR_COMPARISON=false

# 비용/동의 승인 후 수동enable | required=yes | env=all
ALLOW_LIVE_MODEL_TESTS=false

# service명, 본문 capture비활성 | required=yes | env=all
OTEL_SERVICE_NAME=proofops-local

# DEBUG여도 문서/secret logging금지 | required=yes | env=all
LOG_LEVEL=INFO

# 실제 보존/삭제 설정 | required=yes | env=all
RETENTION_POLICY_PATH=config/retention.yaml

LOCAL_PARSER_PROFILE_PATH=
# Optional bounded local run settings JSON; never creates approvals or live access.
LOCAL_RUN_SETTINGS_PATH=

LOCAL_EXTRACTION_MODE=
# Optional explicit local_synthetic tag execution; requires settings frozen at run creation.
LOCAL_TAGGING_MODE=

VITE_API_BASE_URL=

VITE_UPLOAD_ORIGIN=

# Optional DART collection CLI credential; inject securely, never log or commit a real key.
# The CLI reads the process environment; it does not automatically load this file.
DART_API_KEY=
